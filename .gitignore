# Flutter / Dart 빌드 산출물
# ---------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata.bak

# pubspec.lock 은 앱 프로젝트에서는 커밋하는 게 맞다.
# 패키지 버전을 고정해서 어느 컴퓨터에서 받아도 같은 빌드가 나오게 하려고.

# ---------------------------------------------
# 비밀 정보 / 개인 환경 - 절대 올리지 말 것
# ---------------------------------------------
android/local.properties
android/key.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision

# Firebase 설정 파일
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# 환경 변수 (API 키, 토큰 등)
.env
.env.*
!.env.example

